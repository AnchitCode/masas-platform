// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, vector]
}

// ==================== ENUMS ====================

enum UserRole {
  CUSTOMER
  PHARMACY
  ADMIN
}

enum PharmacyStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  PHARMACY_VERIFIED
  PHARMACY_REJECTED
  LOW_STOCK_ALERT
  MEDICINE_AVAILABLE
  SYSTEM_ANNOUNCEMENT
}

// ==================== MODELS ====================

/// User account — CUSTOMER, PHARMACY, and ADMIN roles
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String?  @map("password_hash")          // nullable for Google-only users
  name            String?                                  // from register form or Google profile
  avatarUrl       String?  @map("avatar_url")             // Google profile picture
  googleId        String?  @unique @map("google_id")      // Google OAuth sub claim
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  tokenVersion    Int      @default(0) @map("token_version") // increment to revoke all refresh tokens
  role            UserRole @default(PHARMACY)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  pharmacy                Pharmacy?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  authAuditLogs           AuthAuditLog[]
  notifications           Notification[]
  savedSearches           SavedSearch[]

  @@map("users")
}

/// Server-side stored refresh tokens for revocation support
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")      // SHA-256 hash of the JWT
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Hashed password reset tokens (raw token emailed, only hash stored)
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")      // SHA-256(crypto.randomBytes(32))
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

/// Hashed email verification tokens (raw token emailed, only hash stored)
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")      // SHA-256(crypto.randomBytes(32))
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_verification_tokens")
}

/// Authentication audit log for security monitoring
model AuthAuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")                   // nullable for failed login attempts
  action    String                                      // LOGIN, LOGOUT, GOOGLE_LOGIN, PASSWORD_RESET, etc.
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?                                       // additional context (e.g., failure reason)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("auth_audit_logs")
}

/// Pharmacy profile — linked 1:1 with a PHARMACY user
model Pharmacy {
  id            String         @id @default(uuid())
  userId        String         @unique @map("user_id")
  name          String
  licenseNumber String         @unique @map("license_number")
  address       String
  phone         String
  latitude      Float
  longitude     Float
  status        PharmacyStatus @default(PENDING)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory PharmacyInventory[]

  @@index([status])
  @@map("pharmacies")
}

/// Global medicine catalog — shared across all pharmacies
model MedicineCatalog {
  id          String   @id @default(uuid())
  name        String   // stored lowercase for consistent matching
  genericName String?  @map("generic_name")
  manufacturer String?
  category    String?
  dosageForm  String?  @map("dosage_form")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// AI embedding vector (Phase 9) — 768 dimensions for nomic-embed-text.
  /// Nullable: medicines without embeddings still function via keyword search.
  /// Managed via raw SQL ($queryRaw) since Prisma doesn't natively support vector types.
  embedding     Unsupported("vector(768)")?

  /// SHA-256 hash of the canonical text used to generate the embedding.
  /// Used for stale embedding detection: when catalog fields change, the hash
  /// changes, marking the embedding as stale without re-running inference.
  embeddingHash String? @map("embedding_hash")

  // Relations
  inventory PharmacyInventory[]

  @@index([name])
  @@index([genericName])
  @@map("medicine_catalog")
}

/// Pharmacy-specific inventory — links a pharmacy to a medicine with stock info
model PharmacyInventory {
  id          String   @id @default(uuid())
  pharmacyId  String   @map("pharmacy_id")
  medicineId  String   @map("medicine_id")
  price       Float
  quantity    Int      @default(0)
  expiryDate  DateTime? @map("expiry_date")
  isAvailable Boolean  @default(true) @map("is_available")
  lowStockThreshold Int @default(10) @map("low_stock_threshold")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  pharmacy Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine MedicineCatalog @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  availabilityAlerts AvailabilityAlert[]

  // A pharmacy can only have one entry per medicine
  @@unique([pharmacyId, medicineId])
  @@index([pharmacyId])
  @@index([medicineId])
  @@index([isAvailable])
  @@map("pharmacy_inventory")
}

/// Persistent notifications delivered to users
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Saved searches for CUSTOMER users
model SavedSearch {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  query         String
  latitude      Float
  longitude     Float
  radiusKm      Float     @default(5) @map("radius_km")
  isActive      Boolean   @default(true) @map("is_active")
  lastCheckedAt DateTime? @map("last_checked_at")
  lastMatchAt   DateTime? @map("last_match_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilityAlerts AvailabilityAlert[]

  @@index([userId])
  @@map("saved_searches")
}

/// Availability alert deduplication — tracks which (SavedSearch, InventoryItem)
/// combinations have already triggered a notification while stock is positive.
/// Rows are deleted when inventory goes to 0 (reset), allowing re-notification on restock.
model AvailabilityAlert {
  id            String   @id @default(uuid())
  savedSearchId String   @map("saved_search_id")
  inventoryId   String   @map("inventory_id")
  createdAt     DateTime @default(now()) @map("created_at")

  savedSearch SavedSearch       @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  inventory   PharmacyInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([savedSearchId, inventoryId])
  @@index([inventoryId])
  @@map("availability_alerts")
}

// ==================== ANALYTICS MODELS (Phase 10) ====================

/// Append-only log of analytics-relevant business actions.
/// Not event sourcing — this is a denormalized analytics log for time-series counts,
/// admin oversight, and audit trails. Events are immutable once written.
model AnalyticsEvent {
  id         String   @id @default(uuid())
  type       String                         // "INVENTORY_CREATED", "PHARMACY_VERIFIED", etc.
  actorId    String?  @map("actor_id")      // userId who triggered (nullable for system events)
  actorRole  String?  @map("actor_role")    // "CUSTOMER" | "PHARMACY" | "ADMIN" | "SYSTEM"
  pharmacyId String?  @map("pharmacy_id")   // first-class field — 7 of 9 logged events carry pharmacyId
  targetId   String?  @map("target_id")     // inventoryId, medicineId, savedSearchId, etc.
  targetType String?  @map("target_type")   // "INVENTORY" | "MEDICINE" | "PHARMACY"
  metadata   Json?                          // event-specific payload (quantity, medicineName, etc.)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])               // time-range aggregations by type
  @@index([pharmacyId, createdAt])         // per-pharmacy analytics
  @@index([createdAt])                     // TTL cleanup
  @@map("analytics_events")
}

/// One row per search request. Coordinates stored at reduced precision for privacy.
model SearchQuery {
  id               String   @id @default(uuid())
  query            String                    // raw user query (intended: medicine name; treat as user-provided text)
  normalizedQuery  String?  @map("normalized_query")
  latitude         Float                     // reduced to 2 decimal places before storage
  longitude        Float                     // reduced to 2 decimal places before storage
  radiusKm         Float    @map("radius_km")
  resultCount      Int      @map("result_count")   // total from COUNT(*) OVER()
  aiUsed           Boolean  @default(false) @map("ai_used")
  targetMedicineId String?  @map("target_medicine_id")
  targetFound      Boolean? @map("target_found")
  responseTimeMs   Int?     @map("response_time_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  impressions SearchImpression[]

  @@index([createdAt])
  @@index([targetFound, createdAt])          // "unmet demand" queries
  @@index([query, createdAt])                // top queries over time
  @@map("search_queries")
}

/// One row per pharmacy that appeared in a search result. Normalized join table
/// that enables pharmacy search visibility, top queries, leaderboard, and trends.
model SearchImpression {
  id            String   @id @default(uuid())
  searchQueryId String   @map("search_query_id")
  pharmacyId    String   @map("pharmacy_id")
  medicineId    String   @map("medicine_id")
  matchType     String   @map("match_type")   // "exact" | "partial" | "generic" | "semantic"
  position      Int                            // 0-indexed GLOBAL rank across all pages
  createdAt     DateTime @default(now()) @map("created_at")

  searchQuery SearchQuery @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, createdAt])            // pharmacy visibility analytics
  @@index([medicineId, createdAt])            // per-medicine search demand
  @@index([searchQueryId])                    // join efficiency
  @@map("search_impressions")
}

/// Pre-aggregated pharmacy metrics snapshot. Inventory fields are point-in-time
/// observations at aggregation time; counting fields are period-bounded aggregates.
model PharmacyMetricsSnapshot {
  id               String   @id @default(uuid())
  pharmacyId       String   @map("pharmacy_id")
  period           String                    // "hourly" | "daily"
  periodStart      DateTime @map("period_start")
  totalSkus        Int      @map("total_skus")          // point-in-time observation
  inStockSkus      Int      @map("in_stock_skus")       // point-in-time observation
  outOfStockSkus   Int      @map("out_of_stock_skus")   // point-in-time observation
  lowStockSkus     Int      @map("low_stock_skus")      // point-in-time observation
  expiredSkus      Int      @map("expired_skus")        // point-in-time observation
  expiringSoonSkus Int      @map("expiring_soon_skus")  // point-in-time observation
  totalQuantity    Int      @map("total_quantity")       // point-in-time observation
  avgPrice         Float    @map("avg_price")            // point-in-time observation
  healthScore      Int      @map("health_score")         // computed by shared algorithm from observation
  searchImpressions Int     @default(0) @map("search_impressions")  // period-bounded COUNT
  alertsTriggered  Int      @default(0) @map("alerts_triggered")    // period-bounded COUNT
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([pharmacyId, period, periodStart])   // upsert key — idempotent
  @@index([pharmacyId, period, periodStart])
  @@index([periodStart])                         // TTL cleanup
  @@map("pharmacy_metrics_snapshots")
}

